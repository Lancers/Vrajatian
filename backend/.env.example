# ── Vrajatian backend config ─────────────────────────────────────────────
# Copy to .env and fill in. Never commit the real .env (service-role key is a secret).

# HTTP
PORT=3000

# Frontend origin(s) allowed by CORS (comma-separated for more than one)
CORS_ORIGIN=http://localhost:5173

# Supabase — dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
# anon/public key — used only to VERIFY user JWTs
SUPABASE_ANON_KEY=your-anon-public-key
# service-role key — SERVER ONLY. Bypasses RLS; grants full DB + storage access.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Public storage bucket holding package cover images
PACKAGE_IMAGE_BUCKET=package-images
