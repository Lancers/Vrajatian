# Supabase — copy this file to .env.local and fill in your project's values.
# Find both under: Supabase dashboard → Project Settings → API
# Used only for AUTH (admin login/session). Package data goes through the backend API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Vrajatian backend API base URL (NestJS). All package reads/writes go here.
# Local dev only — the backend runs on a different port, so this must be absolute.
# Leave unset in Vercel/production: it defaults to same-origin "/api/v1".
VITE_API_URL=http://localhost:3000/api/v1

# WhatsApp number the "Book Now" wizard redirects to after logging a request.
# Digits only, international format — NO leading +, spaces, or dashes
# (e.g. 919876543210 for a number that displays as +91 98765 43210).
VITE_WHATSAPP_NUMBER=
