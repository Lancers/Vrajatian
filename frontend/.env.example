# Supabase — copy this file to .env.local and fill in your project's values.
# Find both under: Supabase dashboard → Project Settings → API
# Used only for AUTH (admin login/session). Package data goes through the backend API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Vrajatian backend API base URL (NestJS). All package reads/writes go here.
VITE_API_URL=http://localhost:3000/api/v1
